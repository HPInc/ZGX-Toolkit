{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2021",
    "outDir": "dist",
    "lib": [
      "ES2021",
      "ES2022.Error",
      "ES2022.Object"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules", 
    ".vscode-test",
    "src/__mocks__",
    "src/__tests__"
  ]
}