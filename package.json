{
    "name": "zgx-toolkit",
    "displayName": "Z Toolkit",
    "description": "Manage your SSH connections to remote HP Z devices",
    "version": "0.0.0",
    "publisher": "HPInc",
    "icon": "resources/logo-marketplace.png",
    "galleryBanner": {
        "color": "#1F49D1",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/HPInc/ZGX-Toolkit"
    },
    "bugs": {
        "url": "https://github.com/HPInc/ZGX-Toolkit/issues"
    },
    "homepage": "https://github.com/HPInc/ZGX-Toolkit#readme",
    "license": "SEE LICENSE IN LICENSE",
    "engines": {
        "vscode": "^1.102.3"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "ssh",
        "remote",
        "zgx",
        "hp",
        "device-management",
        "remote-ssh",
        "connection-manager",
        "remote-development",
        "device-discovery",
        "hp-zgx",
        "ztk",
        "z-toolkit"
    ],
    "qna": "marketplace",
    "activationEvents": [],
    "extensionDependencies": [
        "ms-vscode-remote.remote-ssh"
    ],
    "enabledApiProposals": [
        "telemetry"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "zgx-toolkit",
                    "title": "Z Toolkit",
                    "icon": "resources/activitybar-icon.svg"
                }
            ]
        },
        "views": {
            "zgx-toolkit": [
                {
                    "id": "remoteDevicesList",
                    "name": "Devices",
                    "type": "webview",
                    "icon": "resources/activitybar-icon.svg"
                }
            ]
        },
        "commands": [
            {
                "command": "zgxToolkit.openLog",
                "title": "Z Toolkit: Open Log File",
                "icon": "$(file-text)"
            },
            {
                "command": "zgxToolkit.showLogLocation",
                "title": "Z Toolkit: Show Log File Location",
                "icon": "$(info)"
            },
            {
                "command": "zgxToolkit.setLogLevel",
                "title": "Z Toolkit: Set Log Level"
            },
            {
                "command": "zgxToolkit.toggleTelemetry",
                "title": "Z Toolkit: Toggle Telemetry"
            },
            {
                "command": "zgxToolkit.showTelemetryStatus",
                "title": "Z Toolkit: Show Telemetry Status"
            },
            {
                "command": "zgxToolkit.unpairDevices",
                "title": "Z Toolkit: Unpair Devices"
            },
            {
                "command": "zgxToolkit.pairDetails",
                "title": "Z Toolkit: Show Pairing Details"
            }
        ],
        "configuration": {
            "title": "Z Toolkit",
            "properties": {
                "zToolkit.logLevel": {
                    "type": "string",
                    "enum": [
                        "Error",
                        "Warn",
                        "Info",
                        "Debug",
                        "Trace"
                    ],
                    "default": "Info",
                    "description": "Set the logging level for the Z Toolkit extension. Higher levels include all lower level messages."
                },
                "zToolkit.telemetry.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable telemetry for the Z Toolkit extension. This setting is enabled by default; set it to false to opt out. Telemetry is collected only when both this setting and VS Code's global telemetry setting allow it. Telemetry data helps improve the extension by providing insights into usage patterns and potential issues. No personal or sensitive data is collected."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile && npm run bundle && npm run copy-resources",
        "compile": "tsc -p ./",
        "watch": "npm run copy-resources && tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test:unit": "jest --detectOpenHandles",
        "test:unit:watch": "jest --watch",
        "test:unit:coverage": "jest --coverage",
        "compile:integration": "tsc -p ./tsconfig.integration.json",
        "test:integration": "npm run compile && npm run bundle && npm run compile:integration && npm run copy-resources && node ./dist/__tests__/runIntegrationTest.js",
        "bundle": "node scripts/build.mjs",
        "copy-resources": "node scripts/copy-resources.mjs",
        "package": "vsce package --no-dependencies --out dist/"
    },
    "devDependencies": {
        "@types/dnssd": "^0.4.5",
        "@types/jest": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/rwlock": "^5.0.6",
        "@types/semver": "7.8.0",
        "@types/ssh2": "^1.15.5",
        "@types/vscode": "1.102.x",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.9.2",
        "@eslint/js": "^10.0.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.8.1",
        "jest": "^30.4.2",
        "mocha": "^11.8.0",
        "ts-jest": "^29.4.12",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.67.0",
        "globals": "^17.11.0"
    },
    "dependencies": {
        "@vscode/codicons": "^0.0.40",
        "@vscode/extension-telemetry": "^1.2.0",
        "dnssd": "^0.4.1",
        "handlebars": "^4.7.9",
        "rwlock": "^5.0.0",
        "ssh-config": "^5.0.3",
        "ssh2": "^1.17.0"
    },
    "overrides": {
        "ssh2": {
            "cpu-features": "npm:empty-npm-package@^1.0.0"
        },
        "mocha": {
            "serialize-javascript": "npm:serialize-javascript@^7.0.3"
        }
    }
}
